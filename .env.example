# GLM Vision Skill — 环境变量模板
#
# 用法: 复制为 .env 并填入真实值
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# 说明:
#   - .env 已被 .gitignore 忽略, 不会误提交
#   - 显式环境变量优先于 .env (两者都设时以环境变量为准)
#   - 以 # 开头的行是注释; 值可用可选引号包裹, 如 KEY="value"
#   - 免费获取 API key: https://open.bigmodel.cn

# (必填) 智谱开放平台 API Key
ZHIPU_API_KEY=your-key-here

# (可选) 视觉模型, 默认 glm-4.6v-flash (永久免费, 限 1 并发)
# 备选: glm-4.1v-thinking-flash (带思维链, 也免费) / glm-4v-plus (付费增强)
VISION_MODEL=glm-4.6v-flash

# (可选) API 端点, 默认 https://open.bigmodel.cn/api/paas/v4
# 换 OpenAI 兼容的托管 VLM 只需改这两行 + 对应 key(如 SiliconFlow / 阿里百炼):
#   VISION_API_BASE=https://api.siliconflow.cn/v1
#   VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# 或自部署 Ollama (OpenAI 兼容):
#   VISION_API_BASE=http://<服务器IP>:11434/v1
#   VISION_MODEL=qwen2.5-vl:7b
# VISION_API_BASE=https://open.bigmodel.cn/api/paas/v4

# (可选) 生成参数
# VISION_MAX_TOKENS=4096      # 最大输出 token
# VISION_TEMPERATURE=0.2      # 生成温度
# VISION_TIMEOUT=90           # 请求超时(秒)
# VISION_REQUEST_INTERVAL=2.0 # 两次 API 调用最小间隔(秒), 降低 429 限流
