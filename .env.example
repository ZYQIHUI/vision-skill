# Vision Skill — 环境变量模板
#
# 用法: 复制为 .env 并填入真实值
#   Linux/macOS: cp .env.example .env
#   Windows:     copy .env.example .env
#
# 说明:
#   - .env 已被 .gitignore 忽略, 不会误提交
#   - 显式环境变量优先于 .env (两者都设时以环境变量为准)
#   - 以 # 开头的行是注释; 值可用可选引号包裹, 如 KEY="value"
#   - 供应商切换: VISION_PROVIDER=siliconflow (默认) | zhipu
#
# ============================================================
# 供应商 1 (默认): 硅基流动 SiliconFlow
# 免费获取 API key: https://cloud.siliconflow.cn
# API 文档: https://docs.siliconflow.cn
# ============================================================

VISION_PROVIDER=siliconflow

# (必填, 使用硅基流动时) SiliconFlow API Key
SILICONFLOW_API_KEY=your-siliconflow-key

# 主用视觉模型, 默认 Qwen/Qwen3.5-4B (原生视觉多模态, 小尺寸低成本)
# 注意: Qwen/Qwen2.5-VL-* 免费系列已于 2026-03/04 下线, 勿再使用。
# 当前免费多模态仅 OCR/翻译类: PaddlePaddle/PaddleOCR-VL-1.5、tencent/Hunyuan-MT-7B
# 其他常用 VL: Qwen/Qwen3.5-35B-A3B、Qwen/Qwen3-VL-32B-Instruct、zai-org/GLM-4.5V
# VISION_MODEL=Qwen/Qwen3.5-4B

# ============================================================
# 供应商 2 (备用): 智谱开放平台
# 切换方式: 将 VISION_PROVIDER 改为 zhipu, 并填入 ZHIPU_API_KEY
# 免费获取 API key: https://open.bigmodel.cn
# ============================================================

# VISION_PROVIDER=zhipu
# ZHIPU_API_KEY=your-key
# VISION_MODEL=glm-4.6v-flash   # 智谱默认免费模型 (永久免费, 限 1 并发)

# ============================================================
# 通用覆盖 (可选, 任意供应商生效)
# ============================================================

# (可选) 自定义 API 端点, 显式设置优先于供应商预设
# 也可接其他 OpenAI 兼容服务:
#   阿里百炼:  VISION_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   Ollama:    VISION_API_BASE=http://<服务器IP>:11434/v1
# VISION_API_BASE=https://api.siliconflow.cn/v1

# (可选) 统一 API key 覆盖, 优先于 SILICONFLOW_API_KEY / ZHIPU_API_KEY
# VISION_API_KEY=your-key

# (可选) 生成参数
# VISION_MAX_TOKENS=4096      # 最大输出 token
# VISION_TEMPERATURE=0.2      # 生成温度
# VISION_TIMEOUT=90           # 请求超时(秒)
# VISION_REQUEST_INTERVAL=2.0 # 两次 API 调用最小间隔(秒), 降低 429 限流
